{
  "hooks": {
    "afterFileEdit": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/framework-record-edit.py",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/framework-record-response.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "${CURSOR_PLUGIN_ROOT}/hooks/framework-workflow-gate.py",
        "timeout": 180,
        "loop_limit": 2
      }
    ]
  }
}
