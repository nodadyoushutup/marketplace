<!-- LAYOUT CONTRACT
     Maps plugins/code/skills/code-workflow/SKILL.md (marketplace portable craft).

     SPINE  x=1480..1860 — Full-tier happy path, Phase 0 → 10
     LEFT   x=660..1340 — ticket, awaiting, explain, repair, review-fix
     RIGHT  x=2300..2880 — project subagent routing
     BUSES  x=2260 blocked drain; x=1400 repair climb; x=620 explain corridor
     AMBIENT/LEGEND x=40..540
     Typography: every label lives in a filled box with spacing≥12; no bare text
     on the canvas (dark-editor contrast).
-->
<mxfile host="app.diagrams.net" agent="cursor" version="24.0.0">
  <diagram id="code-workflow" name="Coding Workflow (code-workflow)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="legend" value="Legend&#10;&#10;Boxes&#10;blue = workflow phase&#10;yellow = repair / review-fix&#10;green = finish / explain exit&#10;red = blocked&#10;gray = START / END / human pause&#10;purple dashed = parallel fan-out&#10;orange = optional project subagent&#10;&#10;Lines&#10;black = next step&#10;green = explain / finish route&#10;yellow = re-verify loop&#10;purple thick = fan-out then join&#10;red dashed = drain to blocked&#10;orange dashed = advisory subagent&#10;&#10;Layout&#10;center spine = Full path, Phase 0 → 10&#10;left = exits and retries&#10;right = subagent routing&#10;&#10;Notes&#10;Stay in Agent mode. Do not SwitchMode to Plan.&#10;Direct / Standard skip phases per tier note.&#10;Repo hooks (if any) enforce owner tests outside this map." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontColor=#222222" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="500" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="ambient" value="AMBIENT — portable context&#10;&#10;Tier: Direct (default) · Standard · Full&#10;Direct = intake → execute → verify → finish&#10;Standard = + scope + approach + repair&#10;Full = every phase on the spine&#10;&#10;Sibling plugins&#10;global — posture, intensity, writing&#10;business-analyst — BA / planner / researcher&#10;code — this workflow + language rules + agents&#10;&#10;Related skills&#10;code-investigation · code-systematic-debugging&#10;code-deslop · code-refactor · code-verification-before-completion" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=2;fontColor=#333333" parent="1" vertex="1">
