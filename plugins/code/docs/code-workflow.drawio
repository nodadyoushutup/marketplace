        <mxCell id="legend" value="Legend&#10;&#10;Boxes&#10;blue = workflow phase&#10;yellow = repair / review-fix&#10;green = finish / explain exit&#10;red = blocked&#10;gray = START / END / human pause&#10;purple dashed = parallel fan-out&#10;orange = optional project subagent&#10;&#10;Lines&#10;black = next step&#10;green = explain / finish&#10;yellow = re-verify&#10;purple = fan-out region (spine through fill)&#10;red dashed = to blocked&#10;orange dashed = advisory&#10;&#10;Buses&#10;480 repair↓ · 520 awaiting→END · 560 explain→END · 600 review-fix climb&#10;1080 findings · 1180 repair loop&#10;2340 advisory · 2440 blocked drain · y=10 top runway&#10;Fan-out cards sit EAST of spine — spine misses them" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontColor=#222222" parent="1" vertex="1">
